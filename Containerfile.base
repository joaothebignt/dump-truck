# Containerfile.base - Imagem base com todas as dependências
# Build uma vez: podman build -f Containerfile.base -t dumper-base:latest .
#
# Esta imagem contém:
# - Node.js 20
# - Rust 1.83.0
# - Dependências do sistema para Tauri 2 (WebKitGTK)

FROM node:20-bookworm-slim AS node

FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV RUSTUP_HOME=/usr/local/rustup
ENV CARGO_HOME=/usr/local/cargo
ENV PATH=/usr/local/cargo/bin:/usr/local/node/bin:$PATH

# Copiar Node.js da imagem oficial
COPY --from=node /usr/local/bin/node /usr/local/node/bin/node
COPY --from=node /usr/local/bin/corepack /usr/local/node/bin/corepack
COPY --from=node /usr/local/lib/node_modules/ /usr/local/node/lib/node_modules/
RUN ln -s /usr/local/node/bin/node /usr/local/node/bin/nodejs && \
    ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/node/bin/npm && \
    ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/node/bin/npx

# Dependências do sistema para Tauri 2
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    pkg-config \
    libssl-dev \
    libgtk-3-dev \
    libwebkit2gtk-4.1-dev \
    libappindicator3-dev \
    librsvg2-dev \
    curl \
    file \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Instalar Rust
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain 1.83.0 --profile minimal

WORKDIR /app
